# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_RAZORPAY_KEY_ID: Razorpay Client Key ID (test mode: rzp_test_...)
# Frontend reads this from import.meta.env.VITE_RAZORPAY_KEY_ID. Never put secrets here.
VITE_RAZORPAY_KEY_ID="rzp_test_placeholder"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Server-side credentials for Razorpay API orders & signature verification.
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="MY_RAZORPAY_KEY_SECRET"

# DEMO_MODE: When true, allows test-mode bypass for Razorpay sandbox simulation
DEMO_MODE="true"

# VITE_UPI_ID & VITE_UPI_NAME: Hospital Direct UPI payee details
VITE_UPI_ID="meditrack@icici"
VITE_UPI_NAME="MediTrack Healthcare"

# FIREBASE AUTH CONFIGURATION:
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY="AIzaSy_YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# REQUIRE_PHONE_OTP: Set to "true" to enforce SMS OTP phone verification during registration, or "false" to skip
VITE_REQUIRE_PHONE_OTP="true"

